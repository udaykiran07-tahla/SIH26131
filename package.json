{
  "name": "crop-intelligence-sih",
  "version": "1.0.0",
  "description": "Smart India Hackathon: Early Detection and Management of Crop Diseases and Pest Infestations",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "vercel-build": "npm --prefix backend install && npm --prefix frontend install && npm --prefix frontend run build",
    "seed": "npm --prefix backend run seed",
    "test": "npm --prefix backend test",
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.3.1",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.33.3"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": [
    "crop-disease",
    "pest-detection",
    "sih2026",
    "smart-agriculture",
    "nextjs",
    "express",
    "mongodb"
  ],
  "author": "SIH Team",
  "license": "MIT"
}
